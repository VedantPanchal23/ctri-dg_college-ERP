# Production secrets — copy to .env.prod and fill every CHANGE_ME value.
#   copy .env.prod.example .env.prod
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=college_admin
MYSQL_USER=ca_user
MYSQL_PASSWORD=CHANGE_ME_MYSQL

KEYCLOAK_ADMIN=kc_admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KC_ADMIN

# Public URLs as browsers see them (HTTPS in real deploys)
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8081
KC_BIND=127.0.0.1
APP_JWT_ISSUER_URI=http://localhost:8081/realms/college-admin
VITE_KEYCLOAK_URL=http://localhost:8081
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

APP_PORT=8080
FRONTEND_PORT=3000
