{
  "realm": "college-admin",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      { "name": "PLATFORM_SUPER_ADMIN", "description": "Platform super administrator" },
      { "name": "TENANT_ADMIN", "description": "College tenant administrator" },
      { "name": "ACADEMIC_ADMIN", "description": "Academic administrator" },
      { "name": "EXAM_CONTROLLER", "description": "Exam controller" },
      { "name": "FACULTY", "description": "Faculty member" },
      { "name": "HOD", "description": "Head of department" },
      { "name": "STUDENT", "description": "Student" },
      { "name": "PLACEMENT_OFFICER", "description": "Placement officer" },
      { "name": "RECRUITER", "description": "Company recruiter" }
    ]
  },
  "clients": [
    {
      "clientId": "college-admin-api",
      "name": "College Admin API",
      "enabled": true,
      "publicClient": false,
      "secret": "college-admin-api-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "college-admin-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "college-admin-web",
      "name": "College Admin Web",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*", "http://127.0.0.1:3000/*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "college-admin-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
